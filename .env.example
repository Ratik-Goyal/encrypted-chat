# Development defaults. Generate a unique secret before any deployment.
NODE_ENV=development
PORT=3001
MONGODB_URI=
SOCKET_IO_ADAPTER=memory
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXT_PUBLIC_MATRIX_HOMESERVER_URL=
NEXT_PUBLIC_MATRIX_SERVER_NAME=
# Public browser upload cap, in MiB. Set 1-20 to match the selected homeserver.
NEXT_PUBLIC_MATRIX_ATTACHMENT_MAX_MB=20
BLOCKCHAIN_RPC=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_CHAIN_ID=
# Optional browser verification. These values are public; use a read-only RPC endpoint only.
NEXT_PUBLIC_BLOCKCHAIN_READ_RPC_URL=
NEXT_PUBLIC_BLOCKCHAIN_CONTRACT_ADDRESS=
NEXT_PUBLIC_BLOCKCHAIN_CHAIN_ID=
NEXT_PUBLIC_BLOCKCHAIN_CONFIRMATIONS=1
# Keep the commitment signer in a deployment secret manager; never expose it to the browser.
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONFIRMATIONS=1
SEPOLIA_RPC_URL=
# Deployment-only key; never use in the backend or browser.
SEPOLIA_PRIVATE_KEY=
ETHERSCAN_API_KEY=
INTEGRITY_BATCH_INTERVAL_MS=30000
INTEGRITY_MAX_BATCH_WAIT_MS=300000
INTEGRITY_BATCH_SIZE=128
TRUST_PROXY_HOPS=0

# Set only when provisioning an admin, then remove the password.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
