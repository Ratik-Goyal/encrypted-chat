# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/encrypted-chat

# CORS Configuration
# Use "*" for development to allow all origins
# Use comma-separated list for production: http://localhost:3001,http://localhost:4001
